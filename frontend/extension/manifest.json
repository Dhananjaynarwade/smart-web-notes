{
  "manifest_version": 3,
  "name": "Smart Web Notes",
  "version": "1.0.0",
  "description": "Capture selected web content into Smart Web Notes.",

  "permissions": [
    "contextMenus",
    "tabs",
    "scripting",
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  }
}