{
  "manifest_version": 3,
  "name": "Smart Web Notes",
  "version": "1.0.0",
  "description": "Save selected web content to Smart Web Notes.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://smart-web-notes.onrender.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://smart-web-notes.onrender.com/*",
        "http://localhost:4200/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}